# Transactional email (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=notifications@example.com
EMAIL_FROM_NAME=Bold Cave

# Public admin origin used only to build links in owner emails.
ADMIN_BASE_URL=https://admin.example.com

# Optional initial fallback; the storefront URL is editable in Admin settings.
STOREFRONT_BASE_URL=https://example.com
